{
  "version": 1,
  "max_file_bytes": 200000,
  "max_direct_read_lines": 400,
  "max_command_output_chars": 12000,
  "max_output_lines": 160,
  "store_full_tool_output": false,
  "max_log_matches": 120,
  "max_findings_per_shard": 20,
  "max_evidence_chars": 2000,
  "max_files_per_shard": 60,
  "max_bytes_per_shard": 1500000,
  "max_workflow_shards": 10,
  "context_warn_percent": 20,
  "context_block_percent": 30,
  "context_compact_percent": 50,
  "reasoning_by_stage": {
    "inventory": "low",
    "classification": "low",
    "audit": "medium",
    "verification": "medium",
    "critical_synthesis": "high"
  },
  "exclude_dirs": [
    ".git", ".firebreak", "node_modules", "dist", "build", ".next",
    "coverage", "vendor", "__pycache__", ".venv", "venv", ".cache",
    ".idea", ".vscode", "target", "bin", "obj"
  ],
  "exclude_globs": [
    "*.min.js", "*.map", "*.log", "*.zip", "*.7z", "*.tar", "*.gz",
    "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ico", "*.pdf",
    "*.exe", "*.dll", "*.so", "*.dylib", "*.pyc", "*.class"
  ],
  "exclude_sensitive_globs": [
    ".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx",
    "id_rsa", "id_ed25519", "credentials.json", "secrets.json"
  ],
  "generated_markers": ["generated", "autogenerated", "auto-generated", "do not edit"],
  "sensitive_name_patterns": [".env", "secret", "credential", "private-key", "id_rsa", "id_ed25519"],
  "logical_shards": {
    "authentication": "(^|/)(auth|oauth|session|identity|login)(/|$)",
    "api": "(^|/)(api|routes?|controllers?|handlers?)(/|$)",
    "database": "(^|/)(db|database|migrations?|models?|repositories?)(/|$)",
    "frontend": "(^|/)(ui|web|frontend|components?|pages?|views?)(/|$)",
    "infrastructure": "(^|/)(infra|deploy|docker|k8s|terraform|\\.github)(/|$)",
    "tests": "(^|/)(tests?|specs?|__tests__)(/|$)",
    "configuration": "(^|/)(config|settings)(/|$)"
  }
}
